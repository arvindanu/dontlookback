name: Build Android APK

# Builds a debug-signed APK on every push, and (optionally) a release-signed APK when you
# push a tag like v1.0.0 and have added the repository secrets listed below.
on:
  push:
    branches: [main]
    tags: ["v*"]
  workflow_dispatch:

env:
  GODOT_VERSION: "4.3"
  # true only when you have added the RELEASE_KEYSTORE_BASE64 repository secret
  HAS_KEYSTORE: ${{ secrets.RELEASE_KEYSTORE_BASE64 != '' }}

jobs:
  android:
    runs-on: ubuntu-22.04
    container:
      # Community image bundling Godot, export templates, JDK 17 and the Android SDK.
      # If you prefer, pin to another tag from https://hub.docker.com/r/barichello/godot-ci
      image: barichello/godot-ci:4.3
    steps:
      - uses: actions/checkout@v4

      - name: Install export templates
        run: |
          mkdir -p ~/.local/share/godot/export_templates
          cp -r /root/.local/share/godot/export_templates/${GODOT_VERSION}.stable ~/.local/share/godot/export_templates/ || true

      - name: Build debug APK
        run: |
          export ANDROID_HOME=/usr/lib/android-sdk
          tools/build_android.sh debug

      - name: Build release APK (only when secrets are present)
        if: startsWith(github.ref, 'refs/tags/v') && env.HAS_KEYSTORE == 'true'
        env:
          RELEASE_KEY_ALIAS: ${{ secrets.RELEASE_KEY_ALIAS }}
          RELEASE_KEY_PASS: ${{ secrets.RELEASE_KEY_PASS }}
        run: |
          echo "${{ secrets.RELEASE_KEYSTORE_BASE64 }}" | base64 -d > "$RUNNER_TEMP/release.keystore"
          export ANDROID_HOME=/usr/lib/android-sdk
          RELEASE_KEYSTORE="$RUNNER_TEMP/release.keystore" tools/build_android.sh release

      - uses: actions/upload-artifact@v4
        with:
          name: dont-look-back-apk
          path: build/*.apk
